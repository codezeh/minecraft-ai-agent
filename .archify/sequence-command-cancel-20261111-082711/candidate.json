  "cards": [
    {
      "dot": "cyan",
      "title": "接入与下命令",
      "items": [
        "面板用 URL 里的 token 换 HttpOnly cookie，之后整站不再带 token",
        "管理与控制是两条路：send-message 只转发，执行权在 bot 自己手里",
        "角色由握手时出示的哪份凭据决定，面板与 agent 是两份不同的随机串"
      ]
    },
    {
      "dot": "emerald",
      "title": "认领是原子的",
      "items": [
        "board:claim 走 BEGIN IMMEDIATE，读-判断-写整段在事务内",
        "claims.key 有 UNIQUE 索引兜底：判断被绕过也插不进第二行（DB 层拒）",
        "认领与预占是两件事：认领管「谁做这单」，预占管「谁先用这批材料」"
      ]
    },
    {
      "dot": "rose",
      "title": "取消链为什么曾是死代码",
      "items": [
        "prompter 侧早就支持按 signal 取消，但调用点从不传 opts",
        "于是 !stop 之后记忆摘要 / 代码生成 / 看图仍会跑满（最长 120s）",
        "本批接上六处；无在飞操作时传 {}，与改前缺省逐字一致"
      ]
    }
  ]
