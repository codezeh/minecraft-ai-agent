  "cards": [
    {
      "dot": "rose",
      "title": "三个曾经会骗人的终态",
      "items": [
        "setup 抛错用 exit(0)：父进程以为正常结束 ⇒ 不重启、不卸载、面板只显示离线",
        "history.save 抛错 + 调用点不接：未处理拒绝直接打挂进程（一个记忆写失败能杀死整只 bot）",
        "缺同伙时 killAll()：一只 bot 拒绝开工，能把整套 mindserver 关掉（已改为只摘自己）"
      ]
    },
    {
      "dot": "emerald",
      "title": "记忆坏了怎么活",
      "items": [
        "先抢救：截断处结构修复 → 救回 memory + turns + memory_bank",
        "再抢救：正则取 memory 字面量 + 对 memory_bank 做大括号配平扫描",
        "才认输：改名 .corrupt-<ts> 留证 + console.error 吵闹，绝不静默清零"
      ]
    },
    {
      "dot": "amber",
      "title": "谁能杀掉这只 bot",
      "items": [
        "父进程消失 → 看护器让它自杀（避免孤儿进程占着世界）",
        "连服失败 8 次 → 永久 unregister（面板可重建同名）",
        "退出码 >1 时只摘掉自己，不动整机：这是 agent_process 的硬约束"
      ]
    }
  ]
