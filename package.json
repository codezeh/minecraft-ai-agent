{
    "name": "minecraft-ai-agent",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.17.1",
        "@cerebras/cerebras_cloud_sdk": "^1.46.0",
        "@google/genai": "^1.15.0",
        "@huggingface/inference": "^2.8.1",
        "@mistralai/mistralai": "^1.1.0",
        "@nxg-org/mineflayer-smooth-look": "^1.2.4",
        "canvas": "^3.1.0",
        "cheerio": "^1.0.0",
        "express": "^4.18.2",
        "google-translate-api-x": "^10.7.1",
        "groq-sdk": "^0.15.0",
        "minecraft-assets": "^1.16.0",
        "minecraft-data": "^3.117.0",
        "mineflayer": "4.39.0",
        "mineflayer-armor-manager": "^2.0.1",
        "mineflayer-auto-eat": "^5.0.3",
        "mineflayer-collectblock": "^1.4.1",
        "mineflayer-death-event": "^2.0.0",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "mineflayer-schem": "^1.5.2",
        "node-canvas-webgl": "^0.3.0",
        "open": "^10.2.0",
        "openai": "^4.4.0",
        "prismarine-item": "^1.15.0",
        "prismarine-schematic": "^1.3.0",
        "prismarine-viewer": "^1.32.0",
        "replicate": "^0.29.4",
        "ses": "^1.9.1",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.7.2",
        "three": "^0.128.0",
        "vec3": "^0.1.10",
        "yargs": "^17.7.2"
    },
    "overrides": {
        "canvas": "^3.1.0",
        "gl": "^8.1.6"
    },
    "scripts": {
        "postinstall": "patch-package",
        "start": "node main.js",
        "lint": "eslint src main.js",
        "lint:hard": "node tools/lint_hard.mjs",
        "lint:tools": "node tools/lint_ratchet.mjs",
        "lint:all": "npm run lint && npm run lint:tools",
        "test": "node tools/preflight.mjs && node tools/unit_all.mjs",
        "test:units": "node tools/unit_all.mjs",
        "gate": "node tools/patch_integrity.mjs && node tools/check_secret_filenames.mjs && node tools/settings_check.mjs && node tools/preflight_regex_unit.mjs && node tools/preflight.mjs && node tools/lint_hard.mjs",
        "gate:full": "npm run gate && node tools/unit_all.mjs",
        "gate:audit": "node tools/dep_audit_brief.mjs --registry=https://registry.npmjs.org && node tools/dep_audit_brief.mjs --web --registry=https://registry.npmjs.org",
        "gate:install": "git config core.hooksPath .githooks",
        "reinstall": "npm run clean:modules && npm ci",
        "clean:modules": "node -e \"const fs=require('fs');const p=require('path');['node_modules'].forEach(f=>{if(fs.existsSync(f)){if(fs.lstatSync(f).isDirectory()){fs.rmSync(f,{recursive:true,force:true});}else{fs.unlinkSync(f);}}});\"",
        "check:settings": "node tools/settings_check.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.4",
        "eslint-plugin-no-floating-promise": "^2.0.0",
        "globals": "^15.15.0",
        "patch-package": "^8.0.0"
    }
}
