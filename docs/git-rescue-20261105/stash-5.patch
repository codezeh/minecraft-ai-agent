+    //   pathfinder 的 `scafoldingBlocks` 默认是 `[dirt, cobblestone]`
+    //   （movements.js:86-88），而且它**不检查背包数量**。
+    //   所以背包里一块土都没有时，A* 仍会规划一条永远搭不出来的桥。
+    //   `skills.js:1675-1683` 那套已经做了这个检查，`atom_move` 这里漏了
+    //   —— 典型「同一件事两个真相」（见 world_model.js 文件头）。
+    if (scaffold) {
+        const ids = scaffoldItemIds(bot);
+        m.scafoldingBlocks = ids;
+        m.allow1by1towers = ids.length > 0;   // 没方块就关掉，别规划不存在的桥
