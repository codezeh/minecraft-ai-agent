+/**
+ * 适合当脚手架的实心方块。
+ * 选材口径与 `skills.js:1663` 的 goodScaffold 对齐，但**这里用 item id**（原因见 makeMovements）。
+ */
+const SCAFFOLD_ITEM_RE = /^(dirt|grass_block|cobblestone|stone|andesite|diorite|granite|deepslate|sand|gravel|netherrack)$|(_planks|_log)$/;
+
+/**
+ * 背包里真实可用作垫脚的方块 id 列表。
+ *
+ * ★ 必须返回 **item id**，不是 block id。
+ *   `movements.js:156-159` 的判定是 `item.type === id`，而 item.type 是 item id。
+ *   1.21.8 里 dirt 的 blockId=9、itemId=28 —— 混用就永远匹配不上，
+ *   表现出来是「搭桥静默失效」，最难查的那种。
+ */
+function scaffoldItemIds(bot) {
+    const ids = new Set();
+    let inv = [];
+    try { inv = bot.inventory?.items?.() ?? []; } catch { inv = []; }
+    for (const it of inv) {
+        if (!(it?.count > 0)) continue;
+        if (!SCAFFOLD_ITEM_RE.test(String(it.name ?? ''))) continue;
+        ids.add(it.type);
+    }
+    return [...ids];
+}
